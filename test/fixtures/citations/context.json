            "  const config = readConfig();",
            "  const url = `${config.baseUrl}/users/${id}`;",
            "  const res = await request(url, { timeoutMs: config.timeoutMs });",
            "  if (!res.ok) {",
            "    throw new Error(\"user lookup failed\");",
            "  }",
            "  const body = await res.json();",
            "  return body as User;",
